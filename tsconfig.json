{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM"],
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "decision-notebook.ts",
        "decision-notebook/**/*.ts",
        "decision-notebook/**/*.js",
        "_pocket.d.ts",
        "test/**/*.ts"
    ]
}
